# MediKiosk Backend Environment Variables Configuration

# Server & Database Configuration
PORT=8000
DATABASE_URL=sqlite:///./medikiosk.db
# For PostgreSQL: DATABASE_URL=postgresql://medikiosk:medikiosk_secret@localhost:5432/medikiosk_db
REDIS_URL=redis://localhost:6379/0

# Bhashini APIs (Speech-to-Text & Text-to-Speech)
BHASHINI_API_KEY=YOUR_BHASHINI_API_KEY
BHASHINI_USER_ID=YOUR_BHASHINI_USER_ID
BHASHINI_PIPELINE_ID=YOUR_BHASHINI_PIPELINE_ID

# Local AI / Ollama LLM Configuration
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3

# MinIO / Object Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=medikiosk-documents
USE_MINIO=false
